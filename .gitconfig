[user]
	name = Marin Valenčak
	email = valencakmarin@gmail.com
[gpg]
    program = ~/.config/git/gpg-program.sh
[commit]
	gpgsign = true
[tag]
	gpgSign = true
[init]
	defaultBranch = main
[rerere]
	enabled = true
[include]
    path = ~/.config/git/aliases.conf
    path = ~/.config/delta/delta.conf
    path = ~/.config/git/signingkey.conf
[core]
	editor = nvim
	autocrlf = input
[diff]
	tool = nvimdiff
	algorithm = histogram
[merge]
	tool = nvimdiff2
[difftool]
	prompt = false
